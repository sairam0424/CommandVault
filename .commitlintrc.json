{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "scope-enum": [2, "always", ["core", "cli", "vscode", "deps", "ci"]],
    "scope-empty": [1, "never"],
    "type-enum": [2, "always", [
      "feat", "fix", "refactor", "perf", "test",
      "docs", "chore", "ci", "build", "revert"
    ]]
  }
}

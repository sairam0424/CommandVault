{
  "name": "@commandvault/core",
  "version": "0.1.0",
  "description": "Core engine for CommandVault — parsers, three-tier search, file watcher",
  "author": "sairamugge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sairam0424/CommandVault.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sairam0424/CommandVault/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/sairam0424/CommandVault/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "chokidar": "^4.0.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}

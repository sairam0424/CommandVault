{
  "name": "@commandvault/core",
  "version": "0.1.7",
  "description": "Core engine for CommandVault — parsers, three-tier search, file watcher",
  "author": "nothumanslabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sairam0424/CommandVault.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sairam0424/CommandVault/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/sairam0424/CommandVault/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "commands",
    "skills",
    "agents",
    "plugins",
    "claude",
    "copilot",
    "cursor",
    "windsurf",
    "search",
    "vault"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.1.0",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}

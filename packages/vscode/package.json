{
  "name": "commandvault-vscode",
  "displayName": "CommandVault",
  "description": "Browse, search, and manage AI slash commands, skills, agents, plugins, rules, and hooks from your sidebar",
  "version": "0.1.0",
  "author": "sairamugge",
  "license": "MIT",
  "publisher": "commandvault",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sairam0424/CommandVault.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/sairam0424/CommandVault/tree/main/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/sairam0424/CommandVault/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Other"],
  "keywords": ["ai", "commands", "claude", "copilot", "skills", "agents", "vault"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "icon": "media/vault-icon.svg",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commandvault",
          "title": "CommandVault",
          "icon": "media/vault-icon.svg"
        }
      ]
    },
    "views": {
      "commandvault": [
        {
          "id": "commandvault.entries",
          "name": "Commands"
        },
        {
          "id": "commandvault.favorites",
          "name": "Favorites"
        },
        {
          "id": "commandvault.recent",
          "name": "Recently Used"
        }
      ]
    },
    "commands": [
      {
        "command": "commandvault.search",
        "title": "CommandVault: Search Commands",
        "icon": "$(search)"
      },
      {
        "command": "commandvault.refresh",
        "title": "CommandVault: Refresh Vault",
        "icon": "$(refresh)"
      },
      {
        "command": "commandvault.openDetail",
        "title": "CommandVault: View Command Detail"
      },
      {
        "command": "commandvault.toggleFavorite",
        "title": "CommandVault: Toggle Favorite",
        "icon": "$(star)"
      },
      {
        "command": "commandvault.copyCommand",
        "title": "CommandVault: Copy Slash Command",
        "icon": "$(clippy)"
      },
      {
        "command": "commandvault.insertToTerminal",
        "title": "CommandVault: Insert into Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "commandvault.openFile",
        "title": "CommandVault: Open Source File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "commandvault.stats",
        "title": "CommandVault: Show Stats Dashboard"
      },
      {
        "command": "commandvault.export",
        "title": "CommandVault: Export Collection"
      },
      {
        "command": "commandvault.copyContent",
        "title": "CommandVault: Copy Content",
        "icon": "$(copy)"
      },
      {
        "command": "commandvault.sortEntries",
        "title": "CommandVault: Sort Entries",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "commandvault.filterEntries",
        "title": "CommandVault: Filter Entries",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "commandvault.search",
          "when": "view == commandvault.entries",
          "group": "navigation"
        },
        {
          "command": "commandvault.refresh",
          "when": "view == commandvault.entries",
          "group": "navigation"
        },
        {
          "command": "commandvault.sortEntries",
          "when": "view == commandvault.entries",
          "group": "navigation"
        },
        {
          "command": "commandvault.filterEntries",
          "when": "view == commandvault.entries",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "commandvault.toggleFavorite",
          "when": "viewItem == entry",
          "group": "inline"
        },
        {
          "command": "commandvault.copyCommand",
          "when": "viewItem == entry",
          "group": "inline"
        },
        {
          "command": "commandvault.copyContent",
          "when": "viewItem == entry"
        },
        {
          "command": "commandvault.openFile",
          "when": "viewItem == entry"
        },
        {
          "command": "commandvault.insertToTerminal",
          "when": "viewItem == entry"
        }
      ]
    },
    "keybindings": [
      {
        "command": "commandvault.search",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      }
    ],
    "walkthroughs": [
      {
        "id": "commandvault.welcome",
        "title": "Get Started with CommandVault",
        "description": "Learn how to browse, search, and organize your AI commands",
        "steps": [
          {
            "id": "commandvault.welcome.browse",
            "title": "Browse Your Commands",
            "description": "Open the CommandVault sidebar to see all your skills, agents, commands, plugins, rules, and hooks organized by type.\n\n[Open Sidebar](command:workbench.view.extension.commandvault)",
            "media": { "markdown": "media/walkthrough/browse.md" }
          },
          {
            "id": "commandvault.welcome.search",
            "title": "Search and Navigate",
            "description": "Use the search command to quickly find any entry by name, description, or tags. Try it now!\n\n[Search Commands](command:commandvault.search)",
            "media": { "markdown": "media/walkthrough/search.md" }
          },
          {
            "id": "commandvault.welcome.favorites",
            "title": "Favorite and Organize",
            "description": "Star your most-used commands for quick access. Right-click any entry to toggle favorite, copy the slash command, or open the source file.",
            "media": { "markdown": "media/walkthrough/favorites.md" }
          },
          {
            "id": "commandvault.welcome.stats",
            "title": "View Your Dashboard",
            "description": "See statistics about your command collection — entries by type, by source, and your most-used commands.\n\n[Open Dashboard](command:commandvault.stats)",
            "media": { "markdown": "media/walkthrough/stats.md" }
          }
        ]
      }
    ],
    "configuration": {
      "title": "CommandVault",
      "properties": {
        "commandvault.claudeConfigPath": {
          "type": "string",
          "default": "",
          "description": "Path to .claude config directory (auto-detected if empty)"
        },
        "commandvault.enableFileWatcher": {
          "type": "boolean",
          "default": true,
          "description": "Auto-refresh when command files change"
        },
        "commandvault.searchTier": {
          "type": "string",
          "enum": ["fuse", "minisearch", "sqlite"],
          "default": "minisearch",
          "description": "Search engine tier (fuse=fuzzy, minisearch=indexed, sqlite=persistent)"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:webview": "vite build",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:better-sqlite3 --format=cjs --platform=node",
    "dev": "npm run build:extension -- --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@commandvault/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}

{
  "name": "@commandvault/cli",
  "version": "0.1.7",
  "description": "Terminal companion for CommandVault — list, search, and inspect AI commands",
  "author": "nothumanslabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sairam0424/CommandVault.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/sairam0424/CommandVault/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/sairam0424/CommandVault/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "cli",
    "commands",
    "skills",
    "agents",
    "claude",
    "vault",
    "terminal"
  ],
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "type": "module",
  "bin": {
    "vault": "dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@commandvault/core": "workspace:*",
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.5",
    "clipboardy": "^5.3.1",
    "commander": "^13.1.0",
    "ink": "^7.0.1",
    "ink-text-input": "^6.0.0",
    "ora": "^8.2.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}

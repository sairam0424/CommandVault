{
  "name": "@commandvault/cli",
  "version": "0.1.0",
  "description": "Terminal companion for CommandVault — list, search, and inspect AI commands",
  "author": "nothumanslabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sairam0424/CommandVault.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/sairam0424/CommandVault/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/sairam0424/CommandVault/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "cli",
    "commands",
    "skills",
    "agents",
    "claude",
    "vault",
    "terminal"
  ],
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "type": "module",
  "bin": {
    "vault": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@commandvault/core": "workspace:*",
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  }
}
